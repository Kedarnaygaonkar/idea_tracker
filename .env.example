# Gemini API Key (Required for Gemini-based predictions/summarization)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Configuration
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=yuga_evolution_db
MONGODB_COLLECTION=ideas

# OpenAI API Key / OpenRouter API Key (Required for GPT models & semantic search)
OPENAI_API_KEY=your_openai_api_key_here
